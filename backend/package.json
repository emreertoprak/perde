{
  "name": "backend-starter-kit",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready modular monolith backend starter kit",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "tsx watch src/app/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/app/server.js",
    "start:prod": "node dist/app/server.js",
    "worker:dev": "tsx watch src/workers/worker.ts",
    "worker:start": "node dist/workers/worker.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:coverage": "vitest run --coverage",
    "arch:check": "depcruise src --config .dependency-cruiser.cjs",
    "forbidden:check": "node scripts/check-forbidden.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:migrate:prod": "node dist/database/migrate.js",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/database/seeds/seed.ts",
    "db:check": "drizzle-kit check",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "pm2:start": "pm2-runtime ecosystem.config.cjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,mts,cts,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.0.0",
    "@aws-sdk/client-s3": "3.1087.0",
    "@aws-sdk/s3-request-presigner": "3.1087.0",
    "@bull-board/api": "8.1.2",
    "@bull-board/express": "8.1.2",
    "@sentry/node": "10.65.0",
    "argon2": "0.44.0",
    "bullmq": "5.80.2",
    "busboy": "1.6.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "express-rate-limit": "8.5.2",
    "file-type": "21.3.4",
    "helmet": "8.3.0",
    "hpp": "0.2.3",
    "ioredis": "5.10.1",
    "jose": "6.2.3",
    "nodemailer": "9.0.3",
    "openid-client": "6.8.4",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "pm2": "7.0.3",
    "postgres": "3.4.9",
    "posthog-node": "5.42.0",
    "prom-client": "15.1.3",
    "rate-limit-redis": "5.0.0",
    "swagger-ui-express": "5.0.1",
    "uuid": "14.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/busboy": "1.5.4",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/hpp": "0.2.7",
    "@types/node": "26.1.1",
    "@types/nodemailer": "8.0.1",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "@vitest/coverage-v8": "4.1.10",
    "dependency-cruiser": "17.4.3",
    "drizzle-kit": "0.31.10",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.5",
    "supertest": "7.2.2",
    "testcontainers": "12.0.4",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  }
}
