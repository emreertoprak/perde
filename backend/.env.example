NODE_ENV=development
PORT=3000
APP_NAME=Backend Starter Kit
APP_URL=http://localhost:3000
WEB_APP_URL=http://localhost:5173
API_PREFIX=/api
API_VERSION=v1
TRUST_PROXY=false

DATABASE_URL=postgresql://backend:backend@localhost:5432/backend_starter
DATABASE_MAX_CONNECTIONS=10
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=backend-starter

JWT_ISSUER=backend-starter-kit
JWT_AUDIENCE=backend-starter-clients
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ACCESS_PREVIOUS_SECRETS=
JWT_REFRESH_PREVIOUS_SECRETS=
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_SECONDS=2592000
REFRESH_COOKIE_NAME=backend_refresh
CSRF_SECRET=replace-with-a-different-32-character-secret
ENCRYPTION_KEY=base64-encoded-32-byte-key

CORS_ORIGINS=http://localhost:5173
COOKIE_DOMAIN=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=10
FORGOT_PASSWORD_RATE_LIMIT_MAX=5

GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/google/callback
APPLE_LOGIN_ENABLED=false
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/apple/callback

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Backend Starter Kit <noreply@example.test>

STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage
MAX_UPLOAD_BYTES=10485760
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=backend-starter
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_FORCE_PATH_STYLE=true

SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
LOKI_HOST=http://localhost:3100
LOKI_BASIC_AUTH_USER=
LOKI_TOKEN=
METRICS_TOKEN=
DOCS_ENABLED=true
QUEUE_DASHBOARD_ENABLED=true

WEBHOOK_HMAC_SECRET=replace-with-at-least-32-random-characters
WEBHOOK_TOLERANCE_SECONDS=300
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
