---
import { getCollection, render } from 'astro:content';
import Footer from './layout/Footer.astro';
import Navbar from './layout/Navbar.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import type { LegalKey } from '../i18n/routes';
import type { Locale } from '../i18n/ui';
import { legalAlternates } from '../i18n/utils';

interface Props {
  locale: Locale;
  legalKey: LegalKey;
}

const { locale, legalKey } = Astro.props;

const entries = await getCollection('legal');
const entry = entries.find((item) => item.data.key === legalKey && item.data.locale === locale);

if (!entry) {
  throw new Error(`Yasal icerik bulunamadi: ${legalKey} / ${locale}`);
}

const { Content } = await render(entry);
const alternates = legalAlternates(legalKey);
const updatedLabel = locale === 'tr' ? 'Son güncelleme' : 'Last updated';
---

<BaseLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.description}
  path={alternates[locale]}
  alternates={alternates}
>
  <Navbar slot="header" locale={locale} alternates={alternates} solid />

  <article class="legal">
    <div class="shell legal__inner">
      <h1 class="legal__title">{entry.data.title}</h1>
      <p class="legal__meta">
        {updatedLabel}: {entry.data.updatedAt}
      </p>
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>

  <Footer slot="footer" locale={locale} />
</BaseLayout>

<style>
  .legal {
    padding-top: clamp(8rem, 16vh, 11rem);
    padding-bottom: var(--spacing-section);
    background-color: var(--color-ivory);
  }

  .legal__inner {
    max-width: 52rem;
  }

  .legal__title {
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    line-height: 1.05;
  }

  .legal__meta {
    margin-top: 1rem;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-charcoal-soft);
  }
</style>
