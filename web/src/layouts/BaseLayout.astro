---
import { Font } from 'astro:assets';
import { site } from '../data/site';
import type { Locale } from '../i18n/ui';
import { ogLocale, otherLocale, t } from '../i18n/utils';
import { buildJsonLd } from '../lib/seo';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path: string;
  alternates: Record<Locale, string>;
  ogImage?: string | undefined;
  noindex?: boolean;
}

const { locale, title, description, path, alternates, ogImage, noindex = false } = Astro.props;

const copy = t(locale);
const canonical = new URL(path, Astro.site).href;
const fullTitle = `${site.brand.name} | ${title}`;
const jsonLd = buildJsonLd({
  locale,
  siteUrl: new URL('/', Astro.site).href,
  description,
});
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f6f1e9" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    {Object.entries(alternates).map(([loc, href]) => (
      <link rel="alternate" hreflang={loc} href={new URL(href, Astro.site).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(alternates.tr, Astro.site).href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale(locale)} />
    <meta property="og:locale:alternate" content={ogLocale(otherLocale(locale))} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site).href} />}
    <meta name="twitter:card" content="summary_large_image" />

    {/* Yalniz gorunur alanda kullanilan iki dosya preload edilir */}
    <Font
      cssVariable="--font-editorial"
      preload={[{ weight: 300, style: 'normal', subset: 'latin' }]}
    />
    <Font
      cssVariable="--font-grotesk"
      preload={[{ weight: 300, style: 'normal', subset: 'latin' }]}
    />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <script type="application/ld+json" is:inline set:html={jsonLd}></script>
    <slot name="head" />
  </head>
  <body>
    <a
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-ivory focus:px-4 focus:py-3"
      href="#main"
    >
      {copy.nav.skipToContent}
    </a>
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />

    <script>
      import '../scripts/reveal';
      import '../scripts/parallax';
    </script>
  </body>
</html>
